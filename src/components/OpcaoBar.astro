---
// Floating switcher shown only during the proposal phase, so Jess can jump between options.
import { u } from "../lib/url";
interface Props { atual: "a" | "b" | "c" }
const { atual } = Astro.props;
const ops = [["a", "A"], ["b", "B"], ["c", "C"]] as const;
---
<nav class="opbar" aria-label="Opções de site">
  <a href={u("")} class="op-home">propostas</a>
  {ops.map(([k, l]) => <a href={u(`${k}/`)} aria-current={k === atual ? "page" : undefined}>{l}</a>)}
</nav>
<style is:global>
  .opbar { position: fixed; bottom: 14px; left: 50%; transform: translateX(-50%); z-index: 50; display: flex; gap: 2px; padding: 4px; background: #0b0b0c; border-radius: 999px; font: 500 12px/1 var(--neutro); box-shadow: 0 4px 18px rgba(0,0,0,.18); }
  .opbar a { color: #bbb; text-decoration: none; padding: 7px 11px; border-radius: 999px; }
  .opbar a[aria-current] { background: #fff; color: #0b0b0c; }
  .opbar a:hover:not([aria-current]) { color: #fff; }
  .opbar .op-home { padding-right: 14px; }
</style>
