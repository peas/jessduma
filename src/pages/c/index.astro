---
// Opção C: "Matéria". Texture first. Each Drogas Modernas work opens with a full-width macro
// followed by the whole piece (detail -> work; natural scroll, no pinning: the pinned version
// felt like scroll hijacking); a loupe lets the viewer inspect the surface; captions are set like a medication
// leaflet ("Composição"), echoing the series' subject. Still a white wall, still one page.
import Base from "../../layouts/Base.astro";
import Foto from "../../components/Foto.astro";
import OpcaoBar from "../../components/OpcaoBar.astro";
import { getImage } from "astro:assets";
import { artista, series, exposicoes, formacao, img, type Obra } from "../../data/obras";

const [drogas, ...outras] = series;
const comDetalhe = drogas.obras.filter((x) => x.detalhes.length && x.slug !== "doses");
const resto = drogas.obras.filter((x) => !comDetalhe.includes(x));
// The loupe needs one large, fixed URL per work.
const lupa = Object.fromEntries(
  await Promise.all(comDetalhe.map(async (ob) => [ob.slug, (await getImage({ src: img(ob.principal), width: 2400, format: "webp", quality: 85 })).src])),
);
const composicao = (ob: Obra) => ob.tecnica.replace(/ e /, ", ").split(", ");
---
<Base title="Jess Duma · Opção C" bodyClass="c">
  <OpcaoBar atual="c" />

  <section class="capa">
    <Foto name="capa" alt="Detalhe macro: alumínio corroído, comprimidos e resina sobre cianotipia azul" eager class="capa-img" />
    <h1>Jess Duma</h1>
    <nav class="capa-nav">
      <a href="#obras">Obras</a><a href="#trajetoria">Trajetória</a><a href="#contato">Contato</a>
    </nav>
  </section>

  <section class="frase">
    <p>Sua prática mapeia os rastros das relações: <em>entre corpos, espaços e o cotidiano.</em></p>
  </section>

  <section id="obras" class="serie-abre">
    <p class="kicker">Série em curso · 2024–2026</p>
    <h2>{drogas.nome}</h2>
    {drogas.texto.map((t) => <p class="serie-txt">{t}</p>)}
  </section>

  {comDetalhe.map((ob) => (
    <section class="peca">
      <figure class="peca-det revela"><Foto name={ob.detalhes[0]} alt={`${ob.titulo}, detalhe`} /></figure>
      <div class="peca-obra revela">
        <div class="lupa-alvo" data-lupa={lupa[ob.slug]}>
          <Foto name={ob.principal} alt={`${ob.titulo}, ${ob.ano}`} sizes="(min-width: 900px) 60vw, 100vw" />
          <span class="lupa" aria-hidden="true"></span>
        </div>
        <dl class="bula">
          <dt class="bula-nome">{ob.titulo}</dt>
          <dd class="bula-ano">{ob.ano}{ob.formato && <> · {ob.formato}</>}</dd>
          <dt>Composição</dt>
          <dd>{composicao(ob).map((c) => <span>{c}</span>)}</dd>
          <dt>Dimensões</dt>
          <dd>{ob.dimensoes}</dd>
        </dl>
      </div>
    </section>
  ))}

  <section class="demais">
    <p class="kicker">Também em {drogas.nome}</p>
    <div class="demais-grade">
      {resto.map((ob) => (
        <figure>
          <Foto name={ob.principal} alt={`${ob.titulo}, ${ob.ano}`} sizes="(min-width: 900px) 25vw, 50vw" widths={[480, 960]} />
          <figcaption><b>{ob.titulo}</b> · {ob.ano}<br />{ob.tecnica}. {ob.dimensoes}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  {outras.map((s) => (
    <section class="outra">
      <div class="outra-txt">
        <p class="kicker">Série</p>
        <h2>{s.nome}</h2>
        {s.texto.slice(0, 1).map((t) => <p>{t}</p>)}
      </div>
      <div class="outra-fotos">
        {s.obras.map((ob) => (
          <figure>
            <Foto name={ob.principal} alt={`${ob.titulo}, ${ob.ano}`} sizes="(min-width: 900px) 22vw, 50vw" widths={[480, 960]} />
            <figcaption><b>{ob.titulo}</b> · {ob.ano}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  ))}

  <section id="trajetoria" class="traj">
    <div class="traj-bio">
      <Foto name="retrato" alt="Retrato de Jess Duma" sizes="240px" widths={[480]} />
      <p>{artista.bio}</p>
    </div>
    <div class="traj-listas">
      <h3>Exposições</h3>
      <ul>{exposicoes.map((e) => <li><span>{e.ano}</span> {e.titulo}, {e.local}</li>)}</ul>
      <h3>Formação</h3>
      <ul>{formacao.map((e) => <li><span>{e.ano}</span> {e.titulo}{e.local && <>, {e.local}</>}</li>)}</ul>
    </div>
  </section>

  <footer id="contato" class="contato">
    <p class="kicker">Contato, aquisições e exposições</p>
    <a href={`mailto:${artista.email}`}>{artista.email}</a>
    <a href={`https://instagram.com/${artista.instagram}`}>@{artista.instagram}</a>
  </footer>
</Base>

<script>
  // Gentle fade-in when a block enters the screen. Never pins or moves the scroll.
  const io = new IntersectionObserver((es) => {
    for (const e of es) if (e.isIntersecting) { e.target.classList.add("vis"); io.unobserve(e.target); }
  }, { rootMargin: "0px 0px 15% 0px" });
  document.querySelectorAll(".revela").forEach((el) => io.observe(el));
  document.documentElement.classList.add("io");

  // Loupe: a round lens that shows the 2400px file under the cursor (fine pointers only).
  if (matchMedia("(pointer: fine)").matches) {
    for (const alvo of document.querySelectorAll<HTMLElement>("[data-lupa]")) {
      const lente = alvo.querySelector<HTMLElement>(".lupa")!;
      const ZOOM = 3;
      lente.style.backgroundImage = `url(${alvo.dataset.lupa})`;
      alvo.addEventListener("pointermove", (e) => {
        const r = alvo.getBoundingClientRect();
        const x = e.clientX - r.left, y = e.clientY - r.top;
        lente.style.left = `${x}px`;
        lente.style.top = `${y}px`;
        lente.style.backgroundSize = `${r.width * ZOOM}px ${r.height * ZOOM}px`;
        lente.style.backgroundPosition = `${-(x * ZOOM - lente.offsetWidth / 2)}px ${-(y * ZOOM - lente.offsetHeight / 2)}px`;
      });
      alvo.addEventListener("pointerenter", () => lente.classList.add("on"));
      alvo.addEventListener("pointerleave", () => lente.classList.remove("on"));
    }
  }
</script>

<style is:global>
  .c { --lado: clamp(16px, 5vw, 80px); }
  .c .kicker { font: 500 12px/1.4 var(--neutro); text-transform: uppercase; letter-spacing: .14em; color: var(--azul-vivo); margin: 0 0 14px; }

  .c .capa { position: relative; height: 100svh; overflow: hidden; background: #05070f; }
  .c .capa-img { width: 100%; height: 100%; object-fit: cover; }
  .c .capa h1 { position: absolute; right: var(--lado); top: 9vh; margin: 0; color: #fff; font: 400 clamp(56px, 12vw, 190px)/.9 var(--display); text-transform: uppercase; text-align: right; }
  .c .capa-nav { position: absolute; left: var(--lado); bottom: 28px; display: flex; gap: 24px; font: 500 13px var(--neutro); text-transform: uppercase; letter-spacing: .12em; }
  @media (max-width: 700px) { .c .capa-nav { bottom: 76px; } }
  .c .capa-nav a { color: #fff; text-decoration: none; opacity: .85; }
  .c .capa-nav a:hover { opacity: 1; }

  .c .frase { padding: 20vh var(--lado); max-width: 1300px; }
  .c .frase p { margin: 0; font-size: clamp(28px, 4.2vw, 64px); line-height: 1.12; letter-spacing: -.015em; font-weight: 400; }
  .c .frase em { font-style: normal; color: var(--azul); }

  .c .serie-abre { padding: 0 var(--lado) 12vh; display: grid; gap: 8px; }
  .c .serie-abre h2 { margin: 0 0 24px; font: 400 clamp(64px, 13vw, 210px)/.86 var(--display); text-transform: uppercase; }
  .c .serie-txt { max-width: 58ch; margin: 0; font-size: 17px; }

  /* detail first, full width; the whole work right after, in normal scroll */
  .c .peca { padding-bottom: 14vh; }
  .c .peca-det { margin: 0 0 8vh; overflow: hidden; }
  .c .peca-det img { width: 100%; height: min(82svh, 66vw); object-fit: cover; }
  .c .peca-obra { display: grid; justify-items: center; gap: 28px; padding: 0 var(--lado); }
  @media (min-width: 900px) { .c .peca-obra { grid-template-columns: 1fr 300px; justify-items: stretch; align-items: center; gap: 6vw; } }
  /* fade only when the script is alive (html.io); without JS everything is simply visible */
  .io .c .revela { opacity: 0; transition: opacity .8s ease; }
  .io .c .revela.vis { opacity: 1; }
  .c .lupa-alvo { position: relative; justify-self: center; cursor: none; }
  .c .lupa-alvo img { max-height: 76svh; width: auto; }
  .c .lupa { position: absolute; width: 220px; height: 220px; border-radius: 50%; pointer-events: none; transform: translate(-50%, -50%) scale(.6); opacity: 0; transition: opacity .2s, transform .2s; background-repeat: no-repeat; box-shadow: 0 0 0 1px rgba(255,255,255,.7), 0 10px 40px rgba(0,0,0,.35); }
  .c .lupa.on { opacity: 1; transform: translate(-50%, -50%) scale(1); }

  .c .bula { margin: 0; font: 13px/1.5 var(--neutro); border-top: 2px solid var(--tinta); padding-top: 12px; width: min(100%, 300px); }
  .c .bula dt { text-transform: uppercase; letter-spacing: .12em; font-size: 11px; color: var(--cinza); margin-top: 14px; }
  .c .bula dd { margin: 2px 0 0; }
  .c .bula dd span { display: block; }
  .c .bula .bula-nome { font: 400 30px/1 var(--display); text-transform: uppercase; letter-spacing: 0; color: var(--tinta); margin: 0; }
  .c .bula .bula-ano { color: var(--cinza); }

  .c .demais { padding: 16vh var(--lado); }
  .c .demais-grade { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px 20px; }
  @media (min-width: 900px) { .c .demais-grade { grid-template-columns: repeat(4, 1fr); } }
  .c figure { margin: 0; }
  .c figcaption { font: 13px/1.45 var(--neutro); color: var(--cinza); margin-top: 8px; }
  .c figcaption b { color: var(--tinta); font-weight: 500; }

  .c .outra { display: grid; gap: 32px; padding: 12vh var(--lado); border-top: 1px solid var(--cinza-claro); }
  @media (min-width: 900px) { .c .outra { grid-template-columns: 1fr 2fr; gap: 6vw; } }
  .c .outra h2 { margin: 0 0 18px; font: 400 clamp(44px, 6vw, 88px)/.92 var(--display); text-transform: uppercase; }
  .c .outra-txt p:not(.kicker) { font-size: 16px; max-width: 46ch; }
  .c .outra-fotos { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  @media (min-width: 900px) { .c .outra-fotos { grid-template-columns: repeat(3, 1fr); } }

  .c .traj { display: grid; gap: 48px; padding: 14vh var(--lado); background: #f4f4f5; }
  @media (min-width: 900px) { .c .traj { grid-template-columns: 1fr 1fr; gap: 6vw; } }
  .c .traj-bio img { width: 180px; margin-bottom: 24px; }
  .c .traj-bio p { font-size: 18px; max-width: 44ch; margin: 0; }
  .c .traj h3 { font: 500 12px var(--neutro); text-transform: uppercase; letter-spacing: .14em; color: var(--azul-vivo); margin: 0 0 10px; }
  .c .traj ul { list-style: none; padding: 0; margin: 0 0 40px; font-size: 15px; }
  .c .traj li { padding: 7px 0; border-bottom: 1px solid #e2e2e4; }
  .c .traj li span { color: var(--cinza); margin-right: 10px; font-variant-numeric: tabular-nums; }

  .c .contato { background: var(--azul); color: #fff; padding: 16vh var(--lado) 18vh; display: flex; flex-direction: column; gap: 6px; }
  .c .contato .kicker { color: #aab6ee; }
  .c .contato a { color: #fff; text-decoration: none; font: 400 clamp(30px, 6vw, 84px)/1.05 var(--display); text-transform: uppercase; word-break: break-word; }

  @media (prefers-reduced-motion: reduce) {
    .io .c .revela { opacity: 1; transition: none; }
  }
</style>
